{
  "name": "myquota-page",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest",
    "format": "prettier --write .",
    "deploy:copy": "rsync -av --delete dist/ \"$DEPLOY_TARGET\" || cp -r dist/* \"$DEPLOY_TARGET\"",
    "deploy:note": "echo \"To ask the orchestrator to copy the build say: copia compilado. The orchestrator will use the DEPLOY_TARGET env var to copy; DO NOT store private paths in the repo.\""
  },
  "orchestrator": {
    "phrase": "copia compilado",
    "note": "The deploy:copy script uses the DEPLOY_TARGET env var. Do NOT include private deploy paths in the repository."
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.40.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^4.2.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "postcss": "^8.4.0",
    "prettier": "^2.8.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.1.6",
    "vite": "^5.0.0",
    "vitest": "^0.34.0"
  }
}
